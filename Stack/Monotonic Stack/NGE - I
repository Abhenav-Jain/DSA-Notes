🔍 LEETCODE 496 — NEXT GREATER ELEMENT I
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

📌 PATTERN
Monotonic Stack + HashMap

Goal:
nums1 ke har element x ke liye nums2 me x ke
RIGHT side ka first element find karo jo x se greater ho.

Example:

nums1 = [4,1,2]
nums2 = [1,3,4,2]

Output:
[-1,3,-1]

Explanation:

4 → right side me koi greater nahi → -1
1 → next greater = 3
2 → right side me koi greater nahi → -1


━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
🧠 MAIN IDEA
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

Problem ko 2 parts me divide karo:

    Part 1:
    nums2 ke har element ka Next Greater Element
    calculate karo.

    Part 2:
    nums1 ke elements ke liye nums2 se
    precomputed answer lookup karo.


So:

    nums2
      ↓
    NGE calculation
      ↓
    HashMap
      ↓
    nums1 answers


━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
🔥 PART 1 — NGE USING MONOTONIC STACK
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

nums2 ko RIGHT → LEFT traverse karo.

Stack me VALUES store kar rahe hain.

For every nums[i]:

    while stack top <= current:
        pop()

Why?

Agar stack.top() <= nums[i],

to stack.top() future me nums[i] ka
Next Greater Element nahi ban sakta.

Isliye remove.


After popping:

    if stack not empty:
        stack.top() = Next Greater Element

Then:

    stack.push(nums[i])


━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
📚 EXAMPLE
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

nums2 = [1,3,4,2]

Traverse Right → Left


i = 3
value = 2

Stack empty

NGE(2) = -1

push 2

Stack:
[2]


i = 2
value = 4

2 <= 4 → pop

Stack empty

NGE(4) = -1

push 4

Stack:
[4]


i = 1
value = 3

4 > 3

NGE(3) = 4

push 3

Stack:
[4,3]


i = 0
value = 1

3 > 1

NGE(1) = 3

push 1

Stack:
[4,3,1]


Final:

value → NGE

1 → 3
3 → 4
4 → -1
2 → -1


━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
🗺️ PART 2 — HASHMAP
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

NGE result ko directly index se access
karna nums1 ke liye convenient nahi hai.

So create:

    unordered_map<int,int> mp;

Mapping:

    element → next greater element

Example:

    mp[1] = 3
    mp[3] = 4
    mp[4] = -1
    mp[2] = -1


Then nums1 ko traverse karke:

    ans[i] = mp[nums1[i]];


This gives the required answer.


━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
💻 YOUR SOLUTION — CLEAN VERSION
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

class Solution {
public:

    vector<int> NGE(vector<int>& nums) {

        int n = nums.size();

        stack<int> st;
        vector<int> ans(n, -1);

        for(int i = n - 1; i >= 0; i--) {

            while(!st.empty() && st.top() <= nums[i]) {
                st.pop();
            }

            if(!st.empty()) {
                ans[i] = st.top();
            }

            st.push(nums[i]);
        }

        return ans;
    }

    vector<int> nextGreaterElement(
        vector<int>& nums1,
        vector<int>& nums2
    ) {

        vector<int> temp_result = NGE(nums2);

        unordered_map<int, int> mp;

        for(int i = 0; i < nums2.size(); i++) {
            mp[nums2[i]] = temp_result[i];
        }

        vector<int> ans(nums1.size(), -1);

        for(int i = 0; i < nums1.size(); i++) {
            ans[i] = mp[nums1[i]];
        }

        return ans;
    }
};


